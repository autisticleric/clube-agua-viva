<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<link rel="icon" type="image/png" href="data:image/png;base64,">
<title>Clube Água-Viva</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,800&family=Figtree:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#f2fafc; --surface:#ffffff; --ink:#0e3452; --muted:#4d6f86;
  --sea:#4a8fb8; --deep:#12507a; --foam:#b3e5f0; --aqua:#92e0da; --rose:#f0cfdc; --line:#cfe6ee;
  --on-deep:#f2fafc;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    color-scheme:dark;
    --bg:#08202f; --surface:#0f3047; --ink:#e6f5fa; --muted:#9bc0d2;
    --sea:#6fb3d9; --deep:#0c3a58; --line:#1d4a66;
  }
}
:root[data-theme="dark"]{
  color-scheme:dark;
  --bg:#08202f; --surface:#0f3047; --ink:#e6f5fa; --muted:#9bc0d2;
  --sea:#6fb3d9; --deep:#0c3a58; --line:#1d4a66;
}
html{scroll-behavior:smooth;scroll-padding-top:calc(env(safe-area-inset-top,0px) + 72px)}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:'Figtree',system-ui,sans-serif;font-size:1.05rem;line-height:1.6}
h1,h2,h3{font-family:'Fraunces',Georgia,serif;line-height:1.1;margin:0}
a{color:inherit}
:focus-visible{outline:3px solid var(--sea);outline-offset:3px;border-radius:6px}
.wrap{max-width:1040px;margin:0 auto;padding:0 20px}

/* nav */
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:30}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:var(--bg);border-bottom:1px solid var(--line)}
.nav{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 20px;max-width:1040px;margin:0 auto;flex-wrap:wrap}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;font-family:'Fraunces',serif;font-weight:800;font-size:1.2rem}
.brand img{width:40px;height:40px;object-fit:contain}
nav ul{display:flex;gap:6px;list-style:none;margin:0;padding:0;flex-wrap:wrap}
nav a{display:block;padding:8px 14px;border-radius:99px;text-decoration:none;font-weight:500}
nav a:hover{background:var(--foam);color:#0e3452}

/* hero */
.hero{background:linear-gradient(180deg,var(--foam) 0%,#cde9f0 62%,var(--rose) 150%);color:#0e3452;position:relative;overflow:hidden}
.hero .wrap{display:grid;grid-template-columns:1.1fr .9fr;gap:32px;align-items:center;padding-top:56px;padding-bottom:110px}
.hero h1{font-size:clamp(2.6rem,7vw,4.8rem);font-weight:800;letter-spacing:-.02em}
.hero p{font-size:1.2rem;max-width:34ch;margin:18px 0 28px}
.hero .logo{width:100%;max-width:400px;justify-self:center;animation:float 6s ease-in-out infinite;filter:drop-shadow(0 18px 24px rgba(18,80,122,.25))}
@keyframes float{50%{transform:translateY(-14px) rotate(-2deg)}}
@media (prefers-reduced-motion:reduce){.hero .logo{animation:none}html{scroll-behavior:auto}}
.wave{position:absolute;left:0;right:0;bottom:-1px;width:100%;height:70px;display:block}
.wave path{fill:var(--bg)}
.btns{display:flex;gap:12px;flex-wrap:wrap}
.btn{display:inline-block;padding:13px 24px;border-radius:99px;font-weight:700;text-decoration:none;border:2px solid #12507a;cursor:pointer;font:inherit;font-weight:700}
.btn.main{background:linear-gradient(135deg,#12507a,#3a8cb8);color:#f2fafc}
.btn.main:hover{background:linear-gradient(135deg,#0e3f61,#2d77a6)}
.btn.ghost{background:transparent;color:#12507a}
.btn.ghost:hover{background:#12507a;color:#f2fafc}

/* sections */
section{padding:72px 0}
section h2{font-size:clamp(2rem,5vw,3rem);margin-bottom:10px}
.lead{color:var(--muted);max-width:56ch;margin:0 0 36px}
.alt{background:linear-gradient(180deg,var(--surface) 0%,var(--bg) 100%);border-block:1px solid var(--line)}

/* encontros */
.enc-grid{display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:start}
.meet{display:flex;gap:16px;align-items:center;padding:16px 0;border-bottom:1px solid var(--line)}
.meet:first-child{padding-top:0}
.date{flex:0 0 68px;text-align:center;background:linear-gradient(160deg,var(--foam),#8cc7e3);color:#0e3452;border-radius:16px;padding:8px 4px;font-family:'Fraunces',serif;font-weight:800;font-size:1.7rem;line-height:1}
.date small{display:block;font-family:'Figtree',sans-serif;font-weight:700;font-size:.8rem;margin-top:4px}
.meet h3{font-size:1.2rem;margin-bottom:2px}
.meet p{margin:0;color:var(--muted);font-size:.95rem}
.signup{background:linear-gradient(160deg,var(--surface),var(--bg));border:2px solid var(--sea);border-radius:24px;padding:26px}
.signup h3{font-size:1.5rem;margin-bottom:10px}
.signup p{margin:0 0 20px;color:var(--muted)}
label{display:block;font-weight:700;font-size:.95rem;margin:14px 0 6px}
input,select,textarea{width:100%;padding:12px 14px;font:inherit;color:var(--ink);background:var(--surface);border:1.5px solid var(--line);border-radius:12px}
textarea{resize:vertical;min-height:80px}
.signup .btn{width:100%;text-align:center}
.note{font-size:.88rem;color:var(--muted);margin:12px 0 0}
.err{color:#b3264d;font-weight:700;font-size:.9rem;margin:10px 0 0;min-height:1.2em}

/* livros */
.books{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:20px}
.cover{display:block;width:100%;aspect-ratio:2/3;object-fit:cover;background:var(--foam)}
.now-cover{width:120px;aspect-ratio:2/3;object-fit:cover;border-radius:8px 14px 14px 8px;box-shadow:6px 6px 0 rgba(0,0,0,.25)}
.book{background:var(--surface);border:1px solid var(--line);border-radius:18px;overflow:hidden;display:flex;flex-direction:column}
.spine{height:140px;display:flex;align-items:flex-end;padding:14px;font-family:'Fraunces',serif;font-weight:800;font-size:1.25rem;line-height:1.1;color:#0e3452}
.book div.info{padding:14px 16px 18px}
.book h3{font-size:1.05rem}
.book p{margin:4px 0 0;color:var(--muted);font-size:.92rem}
.now{display:grid;grid-template-columns:auto 1fr;gap:22px;align-items:center;background:linear-gradient(135deg,var(--deep) 0%,#2e75a3 100%);color:var(--on-deep);border-radius:24px;padding:26px;margin-bottom:28px}
.now .spine{width:110px;height:150px;border-radius:8px 14px 14px 8px;background:linear-gradient(145deg,#f7dfe9,var(--rose));box-shadow:6px 6px 0 rgba(0,0,0,.2);font-size:1.1rem}
.now h3{font-size:1.6rem}
.now p{margin:6px 0 0;opacity:.9}
.suggest{margin-top:30px;display:flex;gap:14px;align-items:center;flex-wrap:wrap}
.suggest .btn{border-color:var(--sea);color:var(--ink)}
.suggest .btn:hover{background:var(--sea);color:#08202f}

/* loja */
.shop{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:20px}
.item{border:1px solid var(--line);border-radius:18px;background:var(--bg);padding:18px;display:flex;flex-direction:column;gap:6px}
.thumb{aspect-ratio:1/1;border-radius:14px;display:grid;place-items:center;margin-bottom:8px}
.thumb img{width:56%;opacity:.95}
.item h3{font-size:1.1rem}
.item p{margin:0;color:var(--muted);font-size:.92rem}
.price{font-weight:700;font-size:1.15rem;margin-top:auto;padding-top:8px}
.item .btn{padding:10px 18px;text-align:center;border-color:var(--sea);color:var(--ink);font-size:.95rem}
.item .btn:hover{background:var(--sea);color:#08202f}

/* contato */
.contact{background:linear-gradient(160deg,var(--deep) 0%,#2e75a3 100%);color:var(--on-deep);text-align:center}
.contact h2{color:var(--on-deep)}
.contact .lead{color:#c9e4ef;margin-inline:auto}
.contact .btns{justify-content:center}
.contact .btn{border-color:#b3e5f0}
.contact .btn.main{background:linear-gradient(135deg,#d9f2f9,#8cc7e3);color:#0e3452}
.contact .btn.main:hover{background:linear-gradient(135deg,#e8f8fc,#a9d6ea)}
.contact .btn.ghost{background:linear-gradient(135deg,#d9f2f9,#8cc7e3);color:#0e3452}
.contact .btn.ghost:hover{background:linear-gradient(135deg,#e8f8fc,#a9d6ea);color:#0e3452}
footer{padding:26px 20px;text-align:center;color:var(--muted);font-size:.92rem}

@media (max-width:760px){
  .hero .wrap{grid-template-columns:1fr;text-align:center;padding-top:36px}
  .hero p{margin-inline:auto}
  .hero .btns{justify-content:center}
  .hero .logo{max-width:260px;order:-1}
  .enc-grid{grid-template-columns:1fr}
  .now{grid-template-columns:1fr;justify-items:start}
  .nav{justify-content:center}
  section{padding:56px 0}
}
</style>
</head>
<body>

<header>
  <div class="nav">
    <a class="brand" href="#topo"><img src="data:image/png;base64," alt="">Clube Água-Viva</a>
    <nav aria-label="Principal">
      <ul>
        <li><a href="#encontros">Encontros</a></li>
        <li><a href="#livros">Livros</a></li>
        <li><a href="#loja">Loja</a></li>
        <li><a href="#contato">Contato</a></li>
      </ul>
    </nav>
  </div>
</header>

<main id="topo">
<div class="hero">
  <div class="wrap">
    <div>
      <h1>Clube do livro Água-Viva</h1>
      <p>Um clube de leitura só para garotas. Lemos um livro por mês, conversamos e fazemos amizades.</p>
      <div class="btns">
        <a class="btn main" href="#encontros">Quero participar</a>
        <a class="btn ghost" href="#livros">Ver os livros</a>
      </div>
    </div>
    <img class="logo" src="data:image/png;base64," alt="Mascote do clube: uma água-viva de óculos lendo um livro">
  </div>
  <svg class="wave" viewBox="0 0 1200 70" preserveAspectRatio="none" aria-hidden="true"><path d="M0 40 C150 0 300 70 450 38 S750 0 900 36 S1100 62 1200 30 V70 H0Z"/></svg>
</div>

<section id="encontros">
  <div class="wrap">
    <h2>Encontros</h2>
    <p class="lead">Veja a data do próximo encontro e faça sua inscrição pelo grupo do clube.</p>
    <div class="enc-grid">
      <div id="lista"></div>
      <div class="signup">
        <h3>Inscrição</h3>
        <p>Entre no grupo do WhatsApp do clube e avise que quer participar do encontro.</p>
        <a class="btn main" id="formLink" href="#" target="_blank" rel="noopener">Fazer inscrição</a>
      </div>
    </div>
  </div>
</section>

<section id="livros" class="alt">
  <div class="wrap">
    <h2>Livros</h2>
    <p class="lead">O que estamos lendo e os livros que já lemos no clube.</p>
    <div class="now">
      <img class="now-cover" id="nowCover" alt="Capa do livro Bons tempos">
      <div>
        <h3 id="nowTitle">Bons tempos</h3>
        <p id="nowAuthor">Caro Claire Burke</p>
        <p>Estamos lendo agora. Entre no próximo encontro para o debate.</p>
      </div>
    </div>
    <div class="books" id="books"></div>
    <div class="suggest">
      <span>Tem um livro para recomendar?</span>
      <a class="btn" id="sugg" href="#">Sugerir no grupo</a>
    </div>
  </div>
</section>

<section id="loja">
  <div class="wrap">
    <h2>Loja</h2>
    <p class="lead">Itens do clube para levar para os encontros. Toque em “Quero” e fale com a gente no grupo do WhatsApp.</p>
    <div class="shop" id="shop"></div>
  </div>
</section>

<section id="contato" class="contact">
  <div class="wrap">
    <h2>Vem ler com a gente</h2>
    <p class="lead">Acompanhe as novidades no Instagram ou entre no grupo do WhatsApp do clube.</p>
    <div class="btns">
      <a class="btn main" id="igLink" href="https://www.instagram.com/clube_aguaviva/" target="_blank" rel="noopener">Instagram @clube_aguaviva</a>
      <a class="btn ghost" id="waLink" href="#" target="_blank" rel="noopener">Entrar no grupo do WhatsApp</a>
    </div>
  </div>
</section>
</main>

<footer>Clube Água-Viva · Ilhéus, Bahia</footer>

<script>
/* ===== EDITE AQUI ===== */
var WHATSAPP_GRUPO = "https://chat.whatsapp.com/IXhSMmTUANG9zoUc5LAmAR"; /* link do grupo do clube */
var FORMS_URL = WHATSAPP_GRUPO; /* trocar pelo link do Google Forms quando estiver pronto */
var ENCONTROS = [
  {dia:"12", mes:"dez", titulo:"Próximo encontro", info:"Livro do encontro: “Bons tempos”. Mais detalhes no grupo do WhatsApp."}
];
var LIVROS = [
  ["A Legião Estrangeira", "Clarice Lispector"],
  ["O Natal de Poirot", "Agatha Christie"],
  ["A Lista para os Corações Solitários", "Sara Nisha Adams"],
  ["Sangue Raro", "Lucas Santana"],
  ["Flores para Algernon", "Daniel Keyes"],
  ["Matéria Escura", "Blake Crouch"],
  ["O Feitiço do Beijo", "Rachel Hawkins"],
  ["Se Deus Me Chamar Não Vou", "Mariana Salomão Carrara"],
  ["Pequena Coreografia do Adeus", "Aline Bei"],
  ["Hilda Furacão", "Roberto Drummond"],
  ["A Casa dos Budas Ditosos", "João Ubaldo Ribeiro"],
  ["A Paciente Silenciosa", "Alex Michaelides"],
  ["Água-Viva", "Clarice Lispector"]
];
var LOJA = [
  {n:"Ecobag Água-Viva", d:"Para carregar o livro do mês.", p:"R$ 35", c:"#b3e5f0"},
  {n:"Marcadores de página", d:"Kit com 3 marcadores.", p:"R$ 12", c:"#8cc7e3"},
  {n:"Caderno de leitura", d:"Para anotar frases e ideias.", p:"R$ 28", c:"#92e0da"},
  {n:"Adesivos do clube", d:"Cartela com o polvinho.", p:"R$ 10", c:"#b3e5f0"}
];
/* ===================== */

var CAPAS = ["data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,", "data:image/jpeg;base64,"];
var CAPA_ATUAL = "data:image/jpeg;base64,";
document.getElementById('nowCover').src = CAPA_ATUAL;
var LOGO = document.querySelector('.hero .logo').src;
function wa(text){ return WHATSAPP_GRUPO; }
function el(tag, cls, html){ var e=document.createElement(tag); if(cls) e.className=cls; if(html!==undefined) e.innerHTML=html; return e; }

var lista=document.getElementById('lista');
ENCONTROS.forEach(function(m){
  var row=el('div','meet');
  row.innerHTML='<div class="date">'+m.dia+'<small>'+m.mes+'</small></div><div><h3>'+m.titulo+'</h3><p>'+m.info+'</p></div>';
  lista.appendChild(row);
});

var books=document.getElementById('books');
var CORES=['#b3e5f0','#8cc7e3','#92e0da','#6aa8cc'];
LIVROS.forEach(function(b,i){
  var c=el('article','book');
  var topo = CAPAS[i]
    ? '<img class="cover" loading="lazy" src="'+CAPAS[i]+'" alt="Capa do livro '+b[0]+'">'
    : '<div class="spine" style="background:linear-gradient(145deg,'+CORES[i%CORES.length]+',#e6f4f9)">'+b[0]+'</div>';
  c.innerHTML=topo+'<div class="info">'+(CAPAS[i]?'<h3>'+b[0]+'</h3>':'')+'<p>'+b[1]+'</p></div>';
  books.appendChild(c);
});

var shop=document.getElementById('shop');
LOJA.forEach(function(i){
  var c=el('article','item');
  c.innerHTML='<div class="thumb" style="background:linear-gradient(145deg,'+i.c+',#f3fafc)"><img src="'+LOGO+'" alt=""></div><h3>'+i.n+'</h3><p>'+i.d+'</p><div class="price">'+i.p+'</div>';
  var a=el('a','btn','Quero'); a.href=wa('Oi! Quero pedir: '+i.n+' ('+i.p+').'); a.target='_blank'; a.rel='noopener';
  c.appendChild(a); shop.appendChild(c);
});

document.getElementById('waLink').href = wa('Oi! Vim pelo site do Clube Água-Viva.');
document.getElementById('sugg').href = wa('Oi! Quero sugerir um livro para o clube: ');
document.getElementById('sugg').target='_blank';

document.getElementById('formLink').href = FORMS_URL;
</script>
</body>
</html>
